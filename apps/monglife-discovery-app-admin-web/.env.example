# 실제 프로파일은 configs 서브모듈(프라이빗)의 properties/apps/monglife-discovery-app-admin-web/ 에 있다.
# vite.config.ts 가 PROFILE 환경변수로 그쪽 <PROFILE>.env 를 직접 읽으므로 이 저장소에 .env 를 만들 필요가 없다.
# 아래는 키 목록 문서용이다. 접속 주소·비밀값은 여기 두지 않는다.
#
# 모드: local(npm run dev) / dev(npm run dev:dev) / stg(npm run build:stg) / prd(npm run build:prd)

# true 면 MSW 목 핸들러로 동작한다. 실서버를 붙이려면 false.
VITE_ENABLE_MSW=true
# common-api 주소 (context-path /api 포함). 상대 경로면 개발 서버 프록시를 타서 CORS 가 없다.
VITE_API_BASE_URL=/api
# 게이트웨이 주소 (/api/character, /api/user). 아직 화면에서 쓰지 않는다.
VITE_GATEWAY_BASE_URL=/api
# 개발 서버 프록시 대상. VITE_ 접두사가 없어 번들에 들어가지 않는다.
API_PROXY_TARGET=http://localhost:8010
GATEWAY_PROXY_TARGET=http://localhost:8000
